      document.getElementById("note-toggle").addEventListener("click", () => {
        const body = document.getElementById("note-body");
        const open = body.style.display === "block";
        body.style.display = open ? "none" : "block";
        document.getElementById("note-arrow").textContent = open ? "▾" : "▴";
      });

      document.getElementById("reserve-form").addEventListener("submit", (e) => {
        e.preventDefault();
        const name = document.getElementById("res-name").value;
        const phone = document.getElementById("res-phone").value;
        const date = document.getElementById("res-date").value || "Today";
        const guests = document.getElementById("res-guests").value;
        const time = document.getElementById("res-time").value || "Dinner";
        const msg = `👑 *Table Reservation Request — Surbhi Restaurant*\n\n• *Name:* ${name}\n• *Phone:* ${phone}\n• *Date:* ${date}\n• *Time:* ${time}\n• *Guests:* ${guests}\n\n📍 Navagam Dindoli, Surat`;
        window.open(`https://wa.me/${PHONE_RAW}?text=${encodeURIComponent(msg)}`, "_blank");
      });

      document.getElementById("checkout-form").addEventListener("submit", (e) => {
        e.preventDefault();
        sendPrefilledCheckoutWhatsApp();
      });
    });

    function getCartTotals() {
      const entries = Object.entries(cart);
      let subtotal = 0;
      let itemCount = 0;
      entries.forEach(([id, qty]) => {
        const d = MENU_ITEMS.find(m => m.id === id);
        if (d) {
          subtotal += (d.price || 0) * qty;
          itemCount += qty;
        }
      });
      const deliveryCharge = (itemCount > 0 && subtotal < FREE_DELIVERY_THRESHOLD) ? DELIVERY_CHARGE_AMOUNT : 0;
      const grandTotal = subtotal + deliveryCharge;
      return { entries, subtotal, itemCount, deliveryCharge, grandTotal };
    }

    function renderSpecials() {
      const specials = [
        { id: "bas-1", badge: "BESTSELLER", name: "SP. SURBHI PULAV", nameGu: "સ્પેશિયલ સુરભી પુલાવ", price: 170, image: "surbhi-pulav.jpg" },
        { id: "tan-1", badge: "MUST TRY", name: "PANEER TIKKA DRY", nameGu: "પનીર ટિક્કા ડ્રાય", price: 230, image: "paneer-tikka.jpg" },
        { id: "bas-8", badge: "MUST TRY", name: "VEG HYDERABADI BIRYANI", nameGu: "વેજ હૈદરાબાદી બિરયાની", price: 140, image: "veg-biryani.jpg" },
        { id: "app-1", badge: "BESTSELLER", name: "SP. LASSI", nameGu: "સ્પેશિયલ લસ્સી", price: 80, image: "sp-lassi.jpg" }
      ];
      document.getElementById("specials-container").innerHTML = specials.map((sp, i) => `
        <div class="editorial-card special-card" onclick="modifyCart('${sp.id}', 1)">
          <div style="aspect-ratio:1/1; position:relative; overflow:hidden;">
            ${createLuxuryGraphic(sp.image, 200 + i)}
            <span class="badge-tag">${sp.badge}</span>
          </div>
          <div style="padding:14px;">
            <h3 class="font-serif" style="font-size:15px; text-transform:uppercase;">${sp.name}</h3>
            <p style="font-size:12px; color:var(--gold); margin-top:4px;">₹${sp.price} <span style="color:var(--text-muted);">· ${sp.nameGu}</span></p>
          </div>
        </div>
      `).join("");
    }

    function scrollSpecials(dir) {
      document.getElementById("specials-container").scrollBy({ left: dir * 260, behavior: "smooth" });
    }

    function renderCategories() {
      const cats = ["All Menu", ...new Set(MENU_ITEMS.map(i => i.category))];
      document.getElementById("category-tabs").innerHTML = cats.map(c => `
        <button type="button" class="cat-tab ${c === activeCategory ? 'active' : ''}" onclick="selectCategory('${c}')">${c}</button>
      `).join("");
    }

    function selectCategory(cat) {
      activeCategory = cat;
      renderCategories();
      renderMenu();
    }

    function renderMenu() {
      const filtered = MENU_ITEMS.filter(item => {
        if (activeCategory !== "All Menu" && item.category !== activeCategory) return false;
        if (filterUnder100 && (item.price === null || item.price >= 100)) return false;
        if (filterBestseller && !item.bestseller) return false;
        if (filterJain && !item.jain) return false;
        if (searchQuery.trim()) {
          const q = searchQuery.toLowerCase();
          if (!item.name.toLowerCase().includes(q) && !item.nameGu.includes(q)) return false;
        }
        return true;
      }).sort((a, b) => {
        if (sortMode === "asc") return (a.price ?? 999) - (b.price ?? 999);
        if (sortMode === "desc") return (b.price ?? 0) - (a.price ?? 0);
        return 0;
      });

      document.getElementById("menu-list").innerHTML = filtered.map((dish, idx) => {
        const qty = cart[dish.id] || 0;
        return `
          <div class="menu-row">
            <div class="menu-thumb">
              ${createLuxuryGraphic(dish.image, idx + 1)}
              ${dish.bestseller ? `<span style="position:absolute; top:4px; left:4px; background:var(--gold); color:#14100D; font-size:8px; font-weight:700; padding:2px 4px; z-index:4;">BESTSELLER</span>` : ''}
            </div>
            <div class="menu-info">
              <div class="menu-name">${dish.name}</div>
              <div class="menu-gu">
                <span>${dish.nameGu}</span>
                <span class="veg-icon"></span>
              </div>
              <div class="menu-price">${dish.price !== null ? '₹' + dish.price : dish.priceLabel}</div>
              ${dish.portion ? `<div class="menu-portion">${dish.portion}</div>` : ''}
            </div>
            <div class="menu-actions">
              <span style="color:var(--text-muted); font-size:14px;">♡</span>
              ${qty === 0 ? `
                <button type="button" class="add-btn" onclick="modifyCart('${dish.id}', 1)">+ ADD TO ORDER</button>
              ` : `
                <div class="qty-control">
                  <button type="button" onclick="modifyCart('${dish.id}', -1)">−</button>
                  <span style="padding:0 6px;">${qty}</span>
                  <button type="button" onclick="modifyCart('${dish.id}', 1)">+</button>
                </div>
              `}
            </div>
          </div>
        `;
      }).join("");
    }

    function modifyCart(id, delta) {
      const next = (cart[id] || 0) + delta;
      if (next <= 0) delete cart[id];
      else cart[id] = next;
      updateCartCounters();
      renderMenu();
      renderCartModalBody();
    }

    function updateCartCounters() {
      const { itemCount } = getCartTotals();
      const badge = document.getElementById("fab-cart-count");
      const waLabel = document.getElementById("bottom-wa-label");
      if (itemCount > 0) {
        badge.style.display = "flex";
        badge.textContent = itemCount;
        waLabel.textContent = `Cart (${itemCount})`;
      } else {
        badge.style.display = "none";
        waLabel.textContent = "WhatsApp";
      }
    }

    function openCartModal() {
      backToCartStep();
      renderCartModalBody();
      document.getElementById("cart-modal").classList.add("open");
    }

    function closeCartModal() {
      document.getElementById("cart-modal").classList.remove("open");
    }

    function backToCartStep() {
      document.getElementById("cart-step-1").style.display = "block";
      document.getElementById("cart-step-2").style.display = "none";
      document.getElementById("modal-step-eyebrow").textContent = "STEP 1 OF 2 · REVIEW TRAY";
      document.getElementById("modal-step-title").textContent = "YOUR ORDER CART";
    }

    function goToCheckoutStep() {
      const { itemCount, subtotal, deliveryCharge, grandTotal } = getCartTotals();
      if (itemCount === 0) return;

      document.getElementById("chk-item-count").textContent = itemCount;
      document.getElementById("chk-subtotal").textContent = "₹" + subtotal;
      document.getElementById("chk-delivery").textContent = deliveryCharge === 0 ? "FREE" : "₹" + deliveryCharge;
      document.getElementById("chk-grand-total").textContent = "₹" + grandTotal;

      document.getElementById("cart-step-1").style.display = "none";
      document.getElementById("cart-step-2").style.display = "block";
      document.getElementById("modal-step-eyebrow").textContent = "STEP 2 OF 2 · DELIVERY & PAYMENT";
      document.getElementById("modal-step-title").textContent = "CHECKOUT DETAILS";
    }

    function selectPaymentMode(mode) {
      selectedPayment = mode;
      const codLabel = document.getElementById("pay-label-cod");
      const upiLabel = document.getElementById("pay-label-upi");
      if (mode.includes("COD")) {
        codLabel.classList.add("selected");
        upiLabel.classList.remove("selected");
      } else {
        upiLabel.classList.add("selected");
        codLabel.classList.remove("selected");
      }
    }

    function renderCartModalBody() {
      const { entries, subtotal, deliveryCharge, grandTotal } = getCartTotals();
      const body = document.getElementById("cart-items-body");
      const footer = document.getElementById("cart-step-1-footer");
      const banner = document.getElementById("cart-delivery-banner");

      if (entries.length === 0) {
        body.innerHTML = `
          <div style="text-align:center; padding:32px 10px;">
            <p style="font-size:13px; color:var(--text-main); margin-bottom:6px;">Your order cart is empty.</p>
            <p style="font-size:11px; color:var(--text-muted); margin-bottom:16px;">Tap <strong>+ ADD TO ORDER</strong> on any dish from the menu to start building your meal.</p>
            <a href="#menu" onclick="closeCartModal()" class="btn-outline" style="padding:9px 16px;">BROWSE MENU</a>
          </div>
        `;
        footer.style.display = "none";
        return;
      }

      footer.style.display = "block";

      if (subtotal < FREE_DELIVERY_THRESHOLD) {
        const diff = FREE_DELIVERY_THRESHOLD - subtotal;
        banner.className = "delivery-banner";
        banner.innerHTML = `
          <span>🛵 Add <strong>₹${diff}</strong> more for <strong>FREE Delivery</strong></span>
          <span class="gold-text">+₹${DELIVERY_CHARGE_AMOUNT} Fee</span>
        `;
      } else {
        banner.className = "delivery-banner free";
        banner.innerHTML = `
          <span>🎉 <strong>FREE Delivery Unlocked!</strong> (Order ₹499+)</span>
          <span>₹0 Fee</span>
        `;
      }

      body.innerHTML = entries.map(([id, qty]) => {
        const dish = MENU_ITEMS.find(m => m.id === id);
        if (!dish) return "";
        const lineTotal = dish.price ? `₹${dish.price * qty}` : "MRP";
        return `
          <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid rgba(212,175,90,0.12);">
            <div style="padding-right:10px;">
              <div class="font-serif" style="font-size:13px; text-transform:uppercase;">${dish.name}</div>
              <div style="font-size:11px; color:var(--text-muted);">${dish.nameGu}</div>
              <div style="font-size:12px; color:var(--gold); font-weight:600; margin-top:2px;">${lineTotal}</div>
            </div>
            <div class="qty-control">
              <button type="button" onclick="modifyCart('${dish.id}', -1)">−</button>
              <span style="padding:0 6px;">${qty}</span>
              <button type="button" onclick="modifyCart('${dish.id}', 1)">+</button>
            </div>
          </div>
        `;
      }).join("");

      document.getElementById("cart-subtotal-price").textContent = "₹" + subtotal;
      document.getElementById("cart-delivery-price").textContent = deliveryCharge === 0 ? "FREE (₹0)" : "₹" + deliveryCharge;
      document.getElementById("cart-grand-total").textContent = "₹" + grandTotal;
    }

    function sendPrefilledCheckoutWhatsApp() {
      const { entries, subtotal, deliveryCharge, grandTotal } = getCartTotals();
      if (entries.length === 0) return;

      const customerName = document.getElementById("chk-name").value.trim();
      const customerPhone = document.getElementById("chk-phone").value.trim();
      const customerAddress = document.getElementById("chk-address").value.trim();

      const itemLines = entries.map(([id, qty], idx) => {
        const d = MENU_ITEMS.find(m => m.id === id);
        const linePrice = d.price ? `₹${d.price * qty}` : "MRP";
        return `${idx + 1}. ${d.name} (${d.nameGu}) x ${qty} = ${linePrice}`;
      });

      const deliveryLine = deliveryCharge > 0
        ? `₹${deliveryCharge} (Orders below ₹499)`
        : `FREE (Order ₹499+)`;

      const message =
        `🙏 *NEW ORDER — SURBHI RESTAURANT*\n\n` +
        `👤 *Customer Name:* ${customerName}\n` +
        (customerPhone ? `📞 *Phone:* ${customerPhone}\n` : ``) +
        `📍 *Delivery Address:* ${customerAddress}\n` +
        `💳 *Payment Mode:* ${selectedPayment}\n\n` +
        `🍽️ *ORDER ITEMS:*\n` +
        itemLines.join("\n") +
        `\n\n────────────────────\n` +
        `• *Items Subtotal:* ₹${subtotal}\n` +
        `• *Delivery Charge:* ${deliveryLine}\n` +
        `💰 *GRAND TOTAL: ₹${grandTotal}*\n` +
        `────────────────────\n` +
        `Please confirm my order!`;

      window.open(`https://wa.me/${PHONE_RAW}?text=${encodeURIComponent(message)}`, "_blank");
    }

    function handleOrderButtonClick() {
      const { itemCount } = getCartTotals();
      if (itemCount > 0) {
        openCartModal();
      } else {
        document.getElementById("menu").scrollIntoView({ behavior: "smooth" });
      }
    }

    function renderGallery() {
      const list = [
        { fileName: "paneer-tikka.jpg", label: "PANEER TIKKA" },
        { fileName: "fried-rice.jpg", label: "VEG FRIED RICE" },
        { fileName: "hara-bhara-kabab.jpg", label: "HARA BHARA KABAB" },
        { fileName: "soup.jpg", label: "CREAM OF TOMATO SOUP" },
        { fileName: "veg-biryani.jpg", label: "VEG HYDERABADI BIRYANI" },
        { fileName: "sp-lassi.jpg", label: "SP. LASSI" },
        { fileName: "surbhi-pulav.jpg", label: "SP. SURBHI PULAV" },
        { fileName: "papad-raita.jpg", label: "PAPAD & RAITA" },
        { fileName: "thali-spread.jpg", label: "PURE VEGETARIAN THALI" },
        { fileName: "interior-ceiling.jpg", label: "WARM DINING AMBIENCE" }
      ];
      document.getElementById("gallery-grid").innerHTML = list.map((g, i) => `
        <div class="gallery-item">
          ${createLuxuryGraphic(g.fileName, 300 + i)}
          <div class="gallery-caption">${g.label}</div>
        </div>
      `).join("");
    }

    function changeStory(dir) {
      storyIdx = (storyIdx + dir + STORIES.length) % STORIES.length;
      document.getElementById("story-title").textContent = STORIES[storyIdx].title;
      document.getElementById("story-text").textContent = STORIES[storyIdx].text;
    }
  </script>
</body>
</html>
