      "postalCode": "394210",
      "addressCountry": "IN"
    }
  }
  </script>

  <style>
    :root {
      --bg-main: #110D0A;
      --bg-surface: #17120D;
      --bg-card: rgba(26, 19, 13, 0.88);
      --text-main: #F6EFE4;
      --text-muted: #B8ACA0;
      --gold: #D4AF5A;
      --gold-bright: #E8CB7A;
      --border-gold: rgba(212, 175, 90, 0.25);
      --veg-green: #22C55E;
    }

    html.light {
      --bg-main: #F6EFE4;
      --bg-surface: #EFE4D4;
      --bg-card: rgba(255, 250, 242, 0.94);
      --text-main: #1A120B;
      --text-muted: #5E4735;
      --gold: #A67C27;
      --gold-bright: #C99E3E;
      --border-gold: rgba(166, 124, 39, 0.32);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: 'Poppins', 'Noto Sans Gujarati', sans-serif;
      overflow-x: hidden;
      line-height: 1.5;
      padding-bottom: 74px;
      background-image:
        radial-gradient(circle at 18% 10%, rgba(212, 175, 90, 0.08) 0%, transparent 45%),
        radial-gradient(circle at 82% 55%, rgba(74, 44, 29, 0.35) 0%, transparent 55%);
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input, select, textarea {
      font-family: inherit;
      color: inherit;
    }

    .container {
      max-width: 960px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .font-serif {
      font-family: 'Playfair Display', 'Cinzel', 'Noto Sans Gujarati', serif;
    }
    .font-display {
      font-family: 'Cinzel', 'Playfair Display', serif;
    }

    .eyebrow {
      font-size: 11px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 500;
      display: block;
      margin-bottom: 8px;
    }

    .section-title {
      font-family: 'Playfair Display', 'Cinzel', serif;
      font-size: clamp(28px, 5vw, 46px);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      line-height: 1.12;
      font-weight: 600;
      margin-bottom: 12px;
    }

    .gold-text {
      color: var(--gold);
    }

    .editorial-card {
      background: var(--bg-card);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid var(--border-gold);
      position: relative;
    }

    .corner-accent::before {
      content: '';
      position: absolute;
      top: -1px;
      left: -1px;
      width: 14px;
      height: 14px;
      border-top: 2px solid var(--gold);
      border-left: 2px solid var(--gold);
      pointer-events: none;
    }

    .corner-accent::after {
      content: '';
      position: absolute;
      bottom: -1px;
      right: -1px;
      width: 14px;
      height: 14px;
      border-bottom: 2px solid var(--gold);
      border-right: 2px solid var(--gold);
      pointer-events: none;
    }

    .btn-gold {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: linear-gradient(90deg, #D4AF5A 0%, #EBD185 50%, #C9A24B 100%);
      color: #14100D;
      font-weight: 600;
      font-size: 12px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 15px 24px;
      border: none;
      border-radius: 2px;
      cursor: pointer;
      box-shadow: 0 6px 22px rgba(201, 162, 75, 0.28);
      transition: transform 0.2s ease, filter 0.2s ease;
    }
    .btn-gold:hover {
      filter: brightness(1.06);
      transform: translateY(-1px);
    }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: rgba(20, 16, 13, 0.75);
      color: #F6EFE4;
      border: 1px solid rgba(212, 175, 90, 0.42);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 13px 16px;
      border-radius: 2px;
      cursor: pointer;
      transition: border-color 0.2s ease, background 0.2s ease;
    }
    .btn-outline:hover {
      border-color: var(--gold);
      background: rgba(212, 175, 90, 0.12);
    }

    .veg-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 13px;
      height: 13px;
      border: 1.5px solid var(--veg-green);
      padding: 2px;
      border-radius: 2px;
      vertical-align: middle;
      flex-shrink: 0;
    }
    .veg-icon::after {
      content: '';
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: var(--veg-green);
      display: block;
    }

    /* Intro Curtain Loader */
    #intro-loader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      pointer-events: none;
      transition: visibility 0.8s;
    }
    .curtain-left, .curtain-right {
      width: 50%;
      height: 100%;
      background: #110D0A;
      transition: transform 0.85s cubic-bezier(0.7, 0, 0.3, 1);
    }
    .curtain-left { border-right: 1px solid rgba(212, 175, 90, 0.3); }
    .curtain-right { border-left: 1px solid rgba(212, 175, 90, 0.3); }
    #intro-loader.open .curtain-left { transform: translateX(-100%); }
    #intro-loader.open .curtain-right { transform: translateX(100%); }
    .loader-center {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transition: opacity 0.45s ease;
    }
    #intro-loader.open .loader-center { opacity: 0; }

    /* Sticky Header */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(17, 13, 10, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(212, 175, 90, 0.16);
      padding: 12px 0;
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .brand-title {
      font-family: 'Cinzel', serif;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.18em;
      color: #F6EFE4;
      display: block;
      line-height: 1;
    }
    .brand-sub {
      font-size: 9px;
      letter-spacing: 0.22em;
      color: var(--gold);
      text-transform: uppercase;
      display: block;
      margin-top: 4px;
    }
    .header-actions {
      display: flex;
      align-items: center;
      gap: 16px;
      color: var(--gold);
    }
    .icon-btn {
      background: none;
      border: none;
      cursor: pointer;
      color: var(--gold);
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4px;
    }
    #nav-drawer {
      display: none;
      padding-top: 14px;
      margin-top: 12px;
      border-top: 1px solid var(--border-gold);
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    #nav-drawer.active {
      display: grid;
    }
    #nav-drawer a {
      font-size: 12px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 8px 10px;
      border-radius: 2px;
    }
    #nav-drawer a:hover {
      background: rgba(212, 175, 90, 0.12);
      color: var(--gold);
    }

    /* Hero Section Adjusted for Surbhi Night Exterior Corner Building */
    .hero {
      position: relative;
      min-height: 87vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 36px 0 24px;
      border-bottom: 1px solid rgba(212, 175, 90, 0.2);
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: -2;
      animation: kenBurns 24s ease-in-out infinite;
    }
    .hero-bg img, .hero-bg svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 68% 35%; /* Keeps the lit Surbhi Restaurant facade & fairy lights visible on the right */
    }
    @keyframes kenBurns {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.07); }
    }
    /* Tailored vignette so left text is crisp while right fairy-light building glows through */
    .hero-overlay {
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        linear-gradient(90deg, rgba(14,10,7,0.92) 0%, rgba(14,10,7,0.72) 48%, rgba(14,10,7,0.28) 100%),
        linear-gradient(0deg, #110D0A 0%, rgba(17,13,10,0.15) 45%, rgba(17,13,10,0.55) 100%);
    }
    .pendant-lamp {
      position: absolute;
      top: 0;
      right: 10%;
      z-index: -1;
      transform-origin: top center;
      animation: swayLamp 5.5s ease-in-out infinite;
      opacity: 0.88;
    }
    @keyframes swayLamp {
      0%, 100% { transform: rotate(-2.5deg); }
      50% { transform: rotate(2.5deg); }
    }
    .hero-photo-picker {
      position: absolute;
      top: 14px;
      right: 16px;
      z-index: 15;
      background: rgba(17, 13, 10, 0.78);
      border: 1px solid rgba(212, 175, 90, 0.45);
      color: var(--gold);
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 6px 10px;
      border-radius: 2px;
      cursor: pointer;
      backdrop-filter: blur(8px);
    }
    .hero-photo-picker:hover {
      background: rgba(212, 175, 90, 0.2);
    }
    .hero-eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
    }
    .hero-eyebrow .line {
      width: 26px;
      height: 1px;
      background: var(--gold);
    }
    .hero-title {
      font-family: 'Playfair Display', 'Cinzel', serif;
      font-size: clamp(42px, 9vw, 72px);
      line-height: 1.05;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      text-shadow: 0 8px 28px rgba(0, 0, 0, 0.75);
    }
    .hero-subtitle {
      margin-top: 18px;
      font-size: 16px;
      color: rgba(246, 239, 228, 0.95);
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);
    }
    .status-pill {
      margin-top: 18px;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 8px 16px;
      border-radius: 999px;
      background: rgba(20, 15, 10, 0.92);
      border: 1px solid rgba(212, 175, 90, 0.4);
      font-size: 12px;
    }
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--veg-green);
      box-shadow: 0 0 8px var(--veg-green);
    }
    .hero-ctas {
      margin-top: 26px;
      max-width: 420px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .hero-cta-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .hero-footer-bar {
      margin-top: 36px;
      padding-top: 14px;
      border-top: 1px solid rgba(212, 175, 90, 0.2);
      font-size: 11px;
      color: var(--text-muted);
    }

    /* About Section */
    .pills-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 22px 0;
    }
    .feature-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      background: var(--bg-card);
      border: 1px solid var(--border-gold);
    }
    .about-collage {
      position: relative;
      margin-top: 24px;
      padding-bottom: 64px;
    }
    .about-main-img {
      width: 84%;
      aspect-ratio: 4 / 5;
      border: 1px solid var(--border-gold);
      overflow: hidden;
      background: #1C130C;
    }
    .about-sub-img {
      width: 52%;
      aspect-ratio: 4 / 5;
      position: absolute;
      right: 0;
      bottom: 0;
      border: 2px solid rgba(212, 175, 90, 0.45);
      overflow: hidden;
      box-shadow: 0 18px 40px rgba(0,0,0,0.75);
      background: #1C130C;
    }
    .about-round-seal {
      width: 98px;
      height: 98px;
      border-radius: 50%;
      background: #140F0A;
      border: 1px solid rgba(212, 175, 90, 0.65);
      position: absolute;
      left: 12px;
      bottom: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 9px;
      letter-spacing: 0.18em;
      line-height: 1.5;
      color: var(--gold);
      text-transform: uppercase;
      box-shadow: 0 10px 25px rgba(0,0,0,0.7);
      z-index: 5;
    }

    /* Specials Track */
    .specials-track {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      padding-bottom: 12px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .specials-track::-webkit-scrollbar { display: none; }
    .special-card {
      min-width: 240px;
      max-width: 260px;
      scroll-snap-align: start;
      flex-shrink: 0;
      cursor: pointer;
    }
    .badge-tag {
      position: absolute;
      top: 10px;
      left: 10px;
      background: var(--gold);
      color: #14100D;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.14em;
      padding: 4px 8px;
      text-transform: uppercase;
      z-index: 5;
    }

    /* Offers Strip */
    .offers-bar {
      background: #17110C;
      border-top: 1px solid var(--border-gold);
      border-bottom: 1px solid var(--border-gold);
      padding: 14px 0;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
    }
    .offers-bar::-webkit-scrollbar { display: none; }

    /* Menu Section */
    .cat-tabs {
      display: flex;
      gap: 24px;
      overflow-x: auto;
      border-bottom: 1px solid rgba(212, 175, 90, 0.2);
      margin-bottom: 18px;
      scrollbar-width: none;
    }
    .cat-tabs::-webkit-scrollbar { display: none; }
    .cat-tab {
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      padding: 10px 2px 12px;
      font-size: 13px;
      color: var(--text-muted);
      white-space: nowrap;
      cursor: pointer;
    }
    .cat-tab.active {
      color: var(--gold);
      border-bottom-color: var(--gold);
      font-weight: 500;
    }

    .search-box {
      position: relative;
      margin-bottom: 12px;
    }
    .search-input {
      width: 100%;
      padding: 12px 14px 12px 38px;
      background: #16110C;
      border: 1px solid var(--border-gold);
      font-size: 13px;
      color: var(--text-main);
      outline: none;
    }
    .search-input:focus {
      border-color: var(--gold);
    }

    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 24px;
    }
    .chip-btn {
      padding: 8px 13px;
      font-size: 12px;
      background: #16110C;
      border: 1px solid var(--border-gold);
      color: var(--text-muted);
      cursor: pointer;
    }
    .chip-btn.active {
      border-color: var(--gold);
      background: rgba(212, 175, 90, 0.18);
      color: var(--gold);
    }

    .menu-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 16px 4px;
      border-bottom: 1px solid rgba(212, 175, 90, 0.15);
    }
    .menu-thumb {
      width: 84px;
      height: 84px;
      position: relative;
      border: 1px solid var(--border-gold);
      flex-shrink: 0;
      overflow: hidden;
      background: #1C130C;
    }
    .menu-info {
      flex: 1;
      min-width: 0;
    }
    .menu-name {
      font-family: 'Playfair Display', 'Cinzel', serif;
      font-size: 15px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-main);
    }
    .menu-gu {
      font-size: 12px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 2px;
    }
    .menu-price {
      font-family: 'Playfair Display', serif;
      font-size: 15px;
      font-weight: 700;
      color: var(--gold);
      margin-top: 6px;
    }
    .menu-portion {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 2px;
    }
    .menu-actions {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      justify-content: space-between;
      min-height: 78px;
      flex-shrink: 0;
    }
    .add-btn {
      padding: 7px 11px;
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      background: #19130E;
      border: 1px solid rgba(212, 175, 90, 0.42);
      color: #F6EFE4;
      cursor: pointer;
    }
    .add-btn:hover {
      border-color: var(--gold);
    }
    .qty-control {
      display: inline-flex;
      align-items: center;
      background: var(--gold);
      color: #14100D;
      font-weight: 700;
      font-size: 12px;
    }
    .qty-control button {
      background: none;
      border: none;
      color: #14100D;
      padding: 5px 9px;
      cursor: pointer;
      font-weight: 700;
    }

    /* Gallery 2-Column Square Grid */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .gallery-item {
      position: relative;
      aspect-ratio: 1 / 1;
      border: 1px solid var(--border-gold);
      overflow: hidden;
      cursor: pointer;
      background: #1C130C;
    }
    .gallery-caption {
      position: absolute;
      inset: auto 0 0 0;
      padding: 28px 12px 10px;
      background: linear-gradient(to top, rgba(0,0,0,0.88), transparent);
      font-family: 'Playfair Display', 'Cinzel', serif;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #F6EFE4;
      z-index: 4;
    }

    /* Form Controls */
    .form-grid-2 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }
    @media (min-width: 600px) {
      .form-grid-2 { grid-template-columns: 1fr 1fr; }
    }
    .field-label {
      display: block;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 6px;
    }
    .field-input {
      width: 100%;
      padding: 12px 14px;
      background: #120E0A;
      border: 1px solid rgba(212, 175, 90, 0.32);
      font-size: 13px;
      color: var(--text-main);
      outline: none;
    }
    .field-input:focus {
      border-color: var(--gold);
    }

    /* Payment Radio Option Cards */
    .payment-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .payment-option {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 11px 12px;
      background: #120E0A;
      border: 1px solid rgba(212, 175, 90, 0.32);
      cursor: pointer;
      font-size: 12px;
      transition: all 0.2s ease;
    }
    .payment-option input[type="radio"] {
      accent-color: var(--gold);
    }
    .payment-option.selected {
      border-color: var(--gold);
      background: rgba(212, 175, 90, 0.15);
      color: var(--gold);
      font-weight: 500;
    }

    /* Delivery Fee Notice Box */
    .delivery-banner {
