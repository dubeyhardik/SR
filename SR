    // Build Hero Background (Tries saved uploaded photo -> IMG_20261031_135910.jpg -> /assets/images/hero-exterior.jpg -> Night Building SVG)
    function renderHeroExterior() {
      const savedHero = localStorage.getItem("surbhi_custom_hero_img");
      const container = document.getElementById("hero-bg-container");
      const svgBackdrop = createSurbhiNightHeroSVG();

      if (savedHero) {
        container.innerHTML = `<img src="${savedHero}" alt="Surbhi Restaurant Night Exterior" />`;
        return;
      }

      container.innerHTML = `
        <div style="width:100%; height:100%; position:relative;">
          ${svgBackdrop}
          <img src="IMG_20261031_135910.jpg"
               alt="Surbhi Restaurant Night Exterior"
               style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:68% 35%; opacity:0; transition:opacity 0.5s;"
               onload="this.style.opacity=1"
               onerror="this.onerror=function(){this.src='https://image.pollinations.ai/prompt/' + encodeURIComponent(AI_IMAGE_PROMPTS['hero-exterior.jpg']) + '?width=1280&height=720&nologo=true&seed=15';}; this.src='/assets/images/hero-exterior.jpg';" />
        </div>
      `;
    }

    // Build AI-Generated Image + Local Asset Support for All Dish & Interior Cards
    function createLuxuryGraphic(fileName, seedOffset = 1) {
      const prompt = AI_IMAGE_PROMPTS[fileName] || "luxury Indian pure vegetarian fine dining dish on dark slate plate, warm golden lighting";
      const aiUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(prompt)}?width=600&height=600&nologo=true&seed=${seedOffset + 42}`;

      // Rich instant SVG placeholder underneath while AI photo or local /assets/images/ file loads
      const isLassi = fileName.includes('lassi');
      const fallbackSvg = `
        <svg viewBox="0 0 300 300" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="g-${seedOffset}" cx="50%" cy="45%" r="60%">
              <stop offset="0%" stop-color="#5E3A21"/>
              <stop offset="60%" stop-color="#24150B"/>
              <stop offset="100%" stop-color="#110B07"/>
            </radialGradient>
          </defs>
          <rect width="300" height="300" fill="url(#g-${seedOffset})"/>
          ${isLassi ? `
            <path d="M110 95 L190 95 L176 235 C172 250, 128 250, 124 235 Z" fill="#F6EFE4" stroke="#D4AF5A" stroke-width="3"/>
          ` : `
            <ellipse cx="150" cy="180" rx="95" ry="52" fill="#17110D" stroke="#D4AF5A" stroke-width="2"/>
            <circle cx="135" cy="170" r="18" fill="#D97706" opacity="0.8"/>
            <circle cx="168" cy="168" r="19" fill="#B45309" opacity="0.8"/>
            <circle cx="150" cy="166" r="6" fill="#22C55E"/>
          `}
        </svg>
      `;

      return `
        <div style="width:100%; height:100%; position:relative; background:#1B120C; overflow:hidden;">
          ${fallbackSvg}
          <img src="/assets/images/${fileName}"
               alt="${fileName.replace('.jpg', '')}"
               loading="lazy"
               style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transition:opacity 0.45s ease, transform 0.6s ease;"
               onload="this.style.opacity=1"
               onerror="if(!this.dataset.aiTried){this.dataset.aiTried='1'; this.src='${aiUrl}';}" />
        </div>
      `;
    }

